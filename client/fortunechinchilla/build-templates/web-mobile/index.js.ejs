import { Application } from '<%= applicationJS %>';

const canvas = document.getElementById('GameCanvas');
const $p = canvas.parentElement;
const bcr = $p.getBoundingClientRect();
canvas.width = bcr.width;
canvas.height = bcr.height;

function topLevelImport (url) {
    return System.import(url);
}

const application = new Application();

// effect.bin has a fixed filename although its format depends on the engine.
// Couple its cache key to the hashed settings file to prevent mixed builds.
function versionPipelineCache(engine, settingsPath) {
    engine.game.onPostBaseInitDelegate.add(() => {
        const effectPath = engine.settings.querySettings('rendering', 'effectSettingsPath');
        if (typeof effectPath !== 'string' || !effectPath) return;
        const separator = effectPath.includes('?') ? '&' : '?';
        engine.settings.overrideSettings('rendering', 'effectSettingsPath',
            `${effectPath}${separator}build=${encodeURIComponent(settingsPath)}`);
    });
}

topLevelImport('cc')
.then((engine) => {
    versionPipelineCache(engine, application.settingsPath);
    return application.init(engine);
}).then(() => {
    return application.start();
}).catch((err) => {
    console.error(err);
});
