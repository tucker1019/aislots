<html>
    <head>
  <meta name="referrer" content="no-referrer">
        <link rel="icon" href="./favicon.ico" />
        <meta charset="utf-8" />
        <title><%=title%></title>
        <meta
            name="viewport"
            content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="full-screen" content="yes" />
        <meta name="screen-orientation" content="portrait" />
        <meta name="x5-fullscreen" content="true" />
        <meta name="360-fullscreen" content="true" />
        <meta name="renderer" content="webkit" />
        <meta name="force-rendering" content="webkit" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

        <link rel="stylesheet" type="text/css" href="./index.css" />

        <link rel="preload" as="image" href="./loading/1025.jpg" />
        <style>
            /* 与预览器选中的设备尺寸一致，在引擎设置行内尺寸前就生效。 */
            <% const coverDevice = devices[config.device] || devices.Default;
               const coverWidth = coverDevice.width || 960;
               const coverHeight = coverDevice.height || 640; %>
            <% if (config.device !== 'FullScreen' && config.device !== 'WebpageFullScreen') { %>
            @media (hover: hover) and (pointer: fine) {
                #GameDiv { width: <%= config.rotate ? coverHeight : coverWidth %>px;
                    height: <%= config.rotate ? coverWidth : coverHeight %>px; }
            }
            <% } %>
            /* 首屏由浏览器直接绘制，不依赖引擎、场景或 Asset Bundle。 */
            #PreviewCover { container-type: inline-size; position: absolute; top: 50%; left: 50%; width: min(100vw, 53.5714vh); height: min(100vh, 186.6667vw); transform: translate(-50%,-50%); z-index: 9999; display: flex;
                align-items: center; justify-content: center; overflow: hidden; background: #000; }
            #PreviewCover img { display: block; width: 100%; height: auto; max-width: none; }
            #PreviewCover .preview-loading { position: absolute; left: 50%; bottom: 17%; width: min(60%, 520px); aspect-ratio: 447 / 28; transform: translateX(-50%); background: url('./loading/jdt.png') center/100% 100% no-repeat; }
            #PreviewCover .preview-loading-fill { height: 100%; width: 0; overflow: hidden; transition: width .2s ease; }
            #PreviewCover .preview-loading-fill::before { content: ''; display: block; width: 100%; height: 100%; background: url('./loading/jdt1.png') left center/auto 78.5714% no-repeat; }
            #PreviewCover .start-button { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); box-sizing: border-box; width: 42%; padding: 3% 0; border: .45cqw solid #ffd96a; border-radius: 1.8cqw; color: #6b2100; background: linear-gradient(#ffe89a, #f6a51a); box-shadow: 0 .8cqw 0 #9b3f05, 0 1.5cqw 3cqw rgba(75,20,0,.35); font: 700 6cqw/1 Helvetica,Arial,sans-serif; letter-spacing: .2cqw; cursor: pointer; }
            #PreviewCover .start-button:active { transform: translate(-50%, 2px); }

    /* 独立于 Cocos 的首屏；黑底覆盖窗口，Logo 按游戏区域等比适配。 */
    #AGOpening { position: fixed; inset: 0; z-index: 2147483647; background: #000; opacity: 1; transition: opacity .3s ease; }
    #AGOpening > svg { position: absolute; left: 50%; top: 50%; width: min(58vw, 31.0714vh); height: auto; transform: translate(-50%, -50%); overflow: visible; animation: ag-reveal .3s ease-out both; }
    @keyframes ag-reveal {
      from { opacity: 0; transform: translate(-50%, -50%) scale(1.12); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      #AGOpening { transition: none; }
      #AGOpening > svg { animation: none; }
    }

</style>
    </head>
    <body style="overflow: hidden;">
  <div id="AGOpening" role="status" aria-label="AG 加载中">
    <svg viewBox="0 0 200 112" aria-hidden="true">
      <rect x="50" y="12" width="100" height="88" rx="8" fill="#ae252a"/>
      <rect x="55" y="17" width="90" height="78" rx="5" fill="none" stroke="#f3dbc0" stroke-opacity=".45"/>
      <text x="99" y="72" text-anchor="middle" fill="#fff0d9" font-family="Georgia, serif"
        font-size="48" font-weight="700" letter-spacing="-4">AG</text>
    </svg>
  </div>

        <%- include(cocosToolBar, {config: config}) %>
        <div id="content" class="content" style="overflow: hidden;">
            <div class="contentWrap">
                <div id="GameDiv" class="wrapper">
                    <div id="PreviewCover" aria-label="游戏加载中">
                        <img src="./loading/1025.jpg" alt="" fetchpriority="high" />
                        <div class="preview-loading" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="preview-loading-fill"></div></div>
                        <button id="PreviewStartButton" class="start-button" type="button" hidden>START</button>
                    </div>
                    <div id="Cocos3dGameContainer">
                        <canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
                    </div>
                    <div id="splash">
                        <div class="progress-bar stripes"><span></span></div>
                    </div>
                    <div id="bulletin">
                        <div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div>
                    </div>
                    <div class="error" id="error">
                        <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
                        <div class="error-main"></div>
                        <div class="error-stack"></div>
                    </div>
                </div>
            </div>
        </div>

  <script>
    (function () {
      var opening = document.getElementById('AGOpening');
      var logo = opening.querySelector('svg');
      var cover = document.getElementById('LoadingScreen') || document.getElementById('PreviewCover');
      var image = cover.querySelector('img');
      var ready = false, minimumElapsed = false, removed = false;
      var observer;
      function fit() {
        var rect = cover.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        logo.style.width = Math.min(rect.width * .58, rect.height * .4) + 'px';
        logo.style.left = rect.left + rect.width / 2 + 'px';
        logo.style.top = rect.top + rect.height / 2 + 'px';
      }
      function finish() {
        if (removed || !ready || !minimumElapsed) return;
        removed = true;
        opening.style.opacity = '0';
        setTimeout(function () { opening.remove(); }, 300);
        window.removeEventListener('resize', fit);
        image.removeEventListener('load', loaded);
        if (observer) observer.disconnect();
      }
      function loaded() {
        if (!image.complete || image.naturalWidth === 0) return;
        // decode 确保封面像素已经可绘制，避免移除黑层后闪空白。
        var decoded = image.decode ? image.decode() : Promise.resolve();
        decoded.then(function () { ready = true; finish(); }).catch(function () {
          if (image.complete && image.naturalWidth > 0) { ready = true; finish(); }
        });
      }
      fit();
      window.addEventListener('resize', fit);
      if (typeof ResizeObserver !== 'undefined') {
        observer = new ResizeObserver(fit);
        observer.observe(cover);
      }
      image.addEventListener('load', loaded);
      loaded(); // 命中浏览器缓存时可能早于监听完成加载。
      // 从首帧开始计时，不能把首次绘制前的脚本耗时算入这一秒。
      requestAnimationFrame(function () {
        setTimeout(function () { minimumElapsed = true; finish(); }, 1000);
      });
    }());
  </script>
        <script src="./preview-cover.js"></script>
        <%- include(cocosTemplate, {}) %>
    </body>
</html>
